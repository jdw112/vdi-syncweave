<ivy-module version="2.0">
  <info organisation="ibm.com" module="cert-manager"/>

  <configurations>
    <conf name="default" description="Runtime dependencies."/>
    <conf name="test"    description="Test-only dependencies." extends="default"/>
  </configurations>

  <dependencies defaultconf="default->default">

    <!-- CLI framework -->
    <dependency org="info.picocli"             name="picocli"                           rev="4.7.6"/>

    <!-- YAML config -->
    <dependency org="org.yaml"                 name="snakeyaml"                         rev="2.2"/>

    <!-- Logging - align with SyncWeave Log4j2 -->
    <dependency org="org.apache.logging.log4j" name="log4j-api"                        rev="2.25.4"/>
    <dependency org="org.apache.logging.log4j" name="log4j-core"                       rev="2.25.4"/>

    <!-- Backup archives -->
    <dependency org="org.apache.commons"       name="commons-compress"                  rev="1.27.1"/>

    <!-- Test scope -->
    <dependency org="org.junit.jupiter"        name="junit-jupiter-api"                 rev="5.11.4" conf="test->default"/>
    <dependency org="org.junit.jupiter"        name="junit-jupiter-engine"              rev="5.11.4" conf="test->default"/>
    <dependency org="org.junit.platform"       name="junit-platform-launcher"           rev="1.11.4" conf="test->default"/>
    <!-- ConsoleLauncher: self-contained JUnit 5 runner, no ant-junitlauncher.jar needed -->
    <dependency org="org.junit.platform"       name="junit-platform-console-standalone" rev="1.11.4" conf="test->default"/>
    <dependency org="org.mockito"              name="mockito-core"                      rev="5.15.2" conf="test->default"/>

  </dependencies>
</ivy-module>