#################################################################
# start up script for IBM Security Verify Directory Integrator for Unix platforms
#################################################################

# Function to source in the SDI setupCmdLine.sh script
setupTDIEnv ()
{
. "$TEMP_BIN_DIR/setupCmdLine.sh"
}

#
# CMDFINDER holds the command which is used to find other commands
# depending on the platform.
#
CMDFINDER=which

UNAME_OS=`uname`

if [ "$UNAME_OS" = "OS/390" -o "$UNAME_OS" = "OS400" ] ; then
	CMDFINDER=whence
fi

TEMP_BIN_DIR=`$CMDFINDER $0`
TEMP_BIN_DIR=`dirname $TEMP_BIN_DIR`
TEMP_BIN_DIR="$TEMP_BIN_DIR/bin"

SKIP_ISCDIR_SETUP=1
setupTDIEnv "$TEMP_BIN_DIR"

PATH="$TDI_HOME_DIR:$TDI_JAVA_BIN_DIR:$PATH"
export PATH

#
# -s overrides TDI_SOLDIR env
#
nosplash=""
solnext=0
for s
do
	case $s in
		-s)  solnext=1;;
		-s*) TDI_SOLDIR="`echo $s | cut -c3-`";;
		-tdishutdown) nosplash="-noSplash"; solnext=0;;
		-*)  solnext=0;;
		*)   if [ $solnext -eq 1 ]; then
			   TDI_SOLDIR=$s
			   solnext=0
			 fi;;
	esac
done

# Create the solution directory if it does not exist
if [ ! -d "$TDI_SOLDIR" ]; then
	mkdir "$TDI_SOLDIR";
fi

# Move to the Solution Directory
cd "$TDI_SOLDIR"

# Create the logs directory if it does not exist
if [ ! -d "logs" ]; then
	mkdir logs;
fi

# Set the library path so all shared libraries are found.
if [ $UNAME_OS = "Linux" -o $UNAME_OS = "SunOS" ] ; then
	LD_LIBRARY_PATH="$TDI_SOLDIR/libs:$TDI_LIB_DIR:$LD_LIBRARY_PATH"
	export LD_LIBRARY_PATH
elif [ $UNAME_OS = "HP-UX" ] ; then
	SHLIB_PATH="$TDI_SOLDIR/libs:$TDI_LIB_DIR:$SHLIB_PATH"
	export SHLIB_PATH
elif [ $UNAME_OS = "Darwin" ] ; then
	DYLD_LIBRARY_PATH="$TDI_SOLDIR/libs:$TDI_LIB_DIR:$DYLD_LIBRARY_PATH"
	export DYLD_LIBRARY_PATH
else
	LIBPATH="$TDI_SOLDIR/libs:$TDI_LIB_DIR:$LIBPATH"
	export LIBPATH
fi

if [ $UNAME_OS = "Darwin" ] ; then
	# The native macOS launcher (miadmin.app) always changes the working
	# directory to miadmin.app/Contents/MacOS.  Start the Equinox launcher
	# with Java directly instead, so the IDE runs in the solution directory
	# as it does on Linux and Windows.  SWT on Cocoa needs
	# -XstartOnFirstThread.
	plugins="$TDI_HOME_DIR/ce/eclipsece/plugins"
	startup_jar=`ls "$plugins"/org.eclipse.equinox.launcher_*.jar | tail -1`
	case `ls -d "$plugins"/org.eclipse.equinox.launcher.cocoa.macosx.*` in
		*aarch64*) arch=aarch64 ;;
		*)         arch=x86_64 ;;
	esac

	# Dock icon: macOS reads the Windows .ico the installer puts in ce/.
	dock_icon=""
	if [ -f "$TDI_HOME_DIR/ce/ibmdi.ico" ] ; then
		dock_icon="-Xdock:icon=$TDI_HOME_DIR/ce/ibmdi.ico"
	fi

	# The Dock labels a process outside an app bundle with its executable's
	# file name, and ignores -Xdock:name for SWT applications.  Run a copy
	# of java named SyncWeave, kept next to java so it finds the JRE.
	java_cmd="$TDI_JAVAW_PROGRAM"
	named_java="`dirname "$TDI_JAVAW_PROGRAM"`/SyncWeave"
	if [ ! -x "$named_java" -o "$TDI_JAVAW_PROGRAM" -nt "$named_java" ] ; then
		cp -p "$TDI_JAVAW_PROGRAM" "$named_java" 2>/dev/null
	fi
	if [ -x "$named_java" ] ; then
		java_cmd="$named_java"
	fi

	# Exit code 23 asks for a restart, which the native launcher would do.
	rc=23
	while [ $rc -eq 23 ] ; do
		"$java_cmd" -XstartOnFirstThread -Xdock:name=SyncWeave ${dock_icon:+"$dock_icon"} -Dcom.ibm.di.loader.IDILoader.path="$TDI_HOME_DIR" -Duser.dir="$TDI_SOLDIR" -jar "$startup_jar" -os macosx -ws cocoa -arch $arch "$@" $nosplash
		rc=$?
	done
else
	"$TDI_HOME_DIR/ce/eclipsece/miadmin" "$@" $nosplash -vm "$TDI_JAVAW_PROGRAM" -vmargs -Dcom.ibm.di.loader.IDILoader.path="$TDI_HOME_DIR" -Duser.dir="$TDI_SOLDIR"
fi

